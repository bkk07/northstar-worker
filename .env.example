# Northstar Worker — documented env vars (no secrets committed).
# Copy to `.env` for local runs. Never commit `.env`.
APP_NAME=northstar-worker
ENVIRONMENT=local
LOG_LEVEL=INFO

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/northstar
OPERATOR_TOKEN=local-operator-token

# HMAC secret binding policy tokens to (task, action, params). Dev parity
# only; the Phase 15 issuer and the MCP token guard must share it.
POLICY_TOKEN_SECRET=local-policy-secret

# LLM (Mercury 2.5 via Inception). Set INCEPTION_API_KEY from Phase 12 on.
INCEPTION_API_KEY=
INCEPTION_MODEL=mercury-2.5
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
