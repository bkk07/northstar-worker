# Northstar Worker — documented env vars (no secrets committed).
# Copy to `.env` for local runs. Never commit `.env`.
APP_NAME=northstar-worker
ENVIRONMENT=local
LOG_LEVEL=INFO

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/northstar
OPERATOR_TOKEN=local-operator-token

# HMAC secret binding policy tokens to (task, action, params). Dev parity
# only; the Phase 15 issuer and the MCP token guard must share it.
POLICY_TOKEN_SECRET=local-policy-secret

# LLM (Mercury 2.5 via Inception). Set INCEPTION_API_KEY from Phase 12 on.
INCEPTION_API_KEY=
INCEPTION_MODEL=mercury-2.5
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# --- 10-phase prototype spec §17 / Phase 1 foundation ---
JWT_SECRET=local-dev-jwt-secret-change-me-please
DELIVERY_DELAY_SECONDS=60
POSTGRES_DB=northstar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
CUSTOMER_WEB_PORT=5174
SUPPORT_WEB_PORT=5175
VITE_API_URL=http://localhost:8000
# Phase 1 support/admin seed (internal staff login). Password is `admin`.
SUPPORT_ADMIN_EMAIL=admin@northstar.shop
SUPPORT_ADMIN_PASSWORD=admin

# Phase 7 support MCP server (business tools on :8003, ns_app role).
SUPPORT_MCP_PORT=8003
NS_APP_DATABASE_URL=postgresql+psycopg://ns_app:northstar@localhost:5433/northstar

# Phase 8 support agent LLM fallback (Groq OpenAI-compatible endpoint; used
# only when INCEPTION_API_KEY is unset. Never commit real keys — keep them in `.env` only).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
