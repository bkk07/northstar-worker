# Northstar Worker — documented env vars (no secrets committed).
# Copy to `.env` for local runs. Never commit `.env`.
APP_NAME=northstar-worker
ENVIRONMENT=local
LOG_LEVEL=INFO

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/northstar
OPERATOR_TOKEN=local-operator-token

# LLM (Mercury 2.5 via Inception). Leave empty until Phase 12.
INCEPTION_API_KEY=
INCEPTION_MODEL=
